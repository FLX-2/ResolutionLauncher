<Window x:Class="ResolutionLauncherModern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resolution Launcher"
        Width="420" Height="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Style="{StaticResource MicaWindowStyle}"
        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

    <Border x:Name="MainBorder" CornerRadius="8" Background="#FF2D2D2D" BorderBrush="#1AFFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#1AFFFFFF" CornerRadius="8,8,0,0">
                <Grid>
                    <TextBlock Text="Resolution Launcher" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0" FontSize="14" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource WindowControlButton}" Content="&#xE921;" Click="Minimize_Click"/>
                        <Button Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="20">
                <!-- Mode Toggle -->
                <Border Background="#1AFFFFFF" CornerRadius="4" Padding="2">
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="ExeMode" Content="EXE/LNK" Style="{StaticResource ModeToggleStyle}" IsChecked="True" Checked="ModeToggle_Checked"/>
                        <RadioButton x:Name="UwpMode" Content="UWP" Style="{StaticResource ModeToggleStyle}" Checked="ModeToggle_Checked"/>
                    </UniformGrid>
                </Border>

                <!-- Target Input -->
                <StackPanel x:Name="ExeTarget" Margin="0,12,0,0">
                    <TextBlock Text="Target" FontSize="13" FontWeight="Medium" Foreground="#CCCCCC" Margin="0,0,0,6"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TargetPath" IsReadOnly="True" Grid.Column="0" Margin="0,0,10,0" Height="36" VerticalContentAlignment="Center" Text="Select application..."/>
                        <Button Content="Browse..." Grid.Column="1" Style="{StaticResource Windows11ButtonSecondary}" MinWidth="90" Height="36" Click="BrowseButton_Click"/>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="UwpTarget" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock Text="UWP Package" FontSize="13" FontWeight="Medium" Foreground="#CCCCCC" Margin="0,0,0,6"/>
                    <TextBox x:Name="UwpPath" Margin="0,6,0,0" Height="36" VerticalContentAlignment="Center" Text="microsoft.minecraftuwp://"/>
                </StackPanel>

                <!-- Resolution -->
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Resolution" FontSize="13" FontWeight="Medium" Foreground="#CCCCCC" Margin="0,0,0,6"/>
                    <ComboBox x:Name="ResolutionCombo" SelectedIndex="0" Height="36" Margin="0,6,0,0">
                        <ComboBoxItem Content="1920×1080"/>
                        <ComboBoxItem Content="2560×1440"/>
                        <ComboBoxItem Content="3840×2160"/>
                        <ComboBoxItem Content="1600×900"/>
                        <ComboBoxItem Content="1280×720"/>
                    </ComboBox>
                </StackPanel>

                <!-- Action Buttons -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Shortcut" Style="{StaticResource Windows11ButtonSecondary}" Margin="0,0,6,0" Height="40"/>
                    <Button Grid.Column="1" Content="Launch" Style="{StaticResource Windows11ButtonPrimary}" Margin="6,0,0,0" Height="40" Click="LaunchButton_Click"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>